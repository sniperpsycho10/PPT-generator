generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Pending
  User
  Admin
  SuperAdmin
  Rejected
}

enum SubmissionType {
  BestPractice
  RepetitiveProblem
  SupportingSlide
}

enum SubmissionStatus {
  Draft
  Submitted
  Reviewed
  Accepted
}

enum SuggestionStatus {
  Pending
  Accepted
  Rejected
  Review
  NeedMoreInfo
}

enum ImplementationStage {
  PendingReview
  FeasibilityAnalysis
  Procurement
  ExecutionShutdown
  ExecutionRunning
  Testing
  Standardized
  Closed
}

enum SafetyImpact {
  High
  Medium
  Low
  None
}

enum ActionItemStatus {
  Open
  InProgress
  Closed
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id            String         @id @default(uuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole       @default(Pending)
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  submissions   Submission[]
  suggestions   Suggestion[]
  actionItems   ActionItem[]
  accounts      Account[]
  sessions      Session[]
  teams         Team[]         @relation("TeamMembers")
  notifications Notification[]
  adoptions     Adoption[]
  auditLogs     AuditLog[]
  comments      Comment[]
  versions      SubmissionVersion[]
  reports       GeneratedReport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  id          String       @id @default(uuid())
  name        String
  qrCodeHash  String       @unique
  users       User[]
  submissions Submission[]
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model Submission {
  id           String         @id @default(uuid())
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         SubmissionType
  title        String
  description  String

  // Best Practice Specific Fields
  objective        String?
  problemAddressed String?
  methodology      String?
  impactSavings    Float?
  downtime         Float?
  calculationTable Json?

  // Repetitive Problem Specific Fields
  equipmentDetails  String?
  problemStatement  String?
  impactCalculation Json?
  whyWhyAnalysis    Json?
  actionTakenTable  Json?

  beforeImageUrl String?
  afterImageUrl  String?
  attachmentUrl  String?

  // Supporting Slide Specific Fields
  supportingSlideType SubmissionType?
  customTable         Json?
  supportingImages    String[]

  // Cycle Linking
  cycleId String?
  cycle   Cycle?  @relation(fields: [cycleId], references: [id])

  status          SubmissionStatus
  submissionMonth DateTime         @default(now())
  deadline        DateTime?
  suggestions     Suggestion[]
  adoptions       Adoption[]
  comments        Comment[]
  versions        SubmissionVersion[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([departmentId])
  @@index([userId])
  @@index([cycleId])
}

model Cycle {
  id          String       @id @default(uuid())
  name        String       @unique // e.g., "June 2026"
  month       String?
  year        String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean      @default(true)
  bpRemarks   String?
  rpRemarks   String?
  createdById String?
  isArchived  Boolean      @default(false)
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model Suggestion {
  id             String           @id @default(uuid())
  submissionId   String?
  submission     Submission?      @relation(fields: [submissionId], references: [id])
  suggestedById  String?
  suggestedBy    User?            @relation(fields: [suggestedById], references: [id], onDelete: Cascade)
  guestName      String?
  guestDept      String?
  suggestionText String
  status         SuggestionStatus

  // Tracking Fields for Steel Plant Execution
  implementationStage  ImplementationStage? @default(PendingReview)
  safetyImpact         SafetyImpact?
  costImplication      Float?
  executingDepartment  String?
  assignedTeamId       String?
  assignedTeam         Team?                @relation("TeamSuggestions", fields: [assignedTeamId], references: [id])
  currentProgress      Int                  @default(0)
  targetCompletionDate DateTime?
  actualCompletionDate DateTime?
  trackingRemarks      String?

  actionItems ActionItem[]
  progressLog SuggestionProgress[]
  comments    Comment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  @@index([submissionId])
  @@index([suggestedById])
}

model ActionItem {
  id           String           @id @default(uuid())
  suggestionId String
  suggestion   Suggestion       @relation(fields: [suggestionId], references: [id])
  assignedToId String
  assignedTo   User             @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  dueDate      DateTime
  status       ActionItemStatus
  evidenceUrl  String?
  remarks      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  @@index([suggestionId, assignedToId])
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  members     User[]       @relation("TeamMembers")
  suggestions Suggestion[] @relation("TeamSuggestions")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SuggestionProgress {
  id               String     @id @default(uuid())
  suggestionId     String
  suggestion       Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  progress         Int
  notes            String?
  photoUrls        String[]
  attachedFileUrl  String?
  attachedFileName String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Adoption {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model AuditLog {
  id            String      @id @default(uuid())
  entityId      String
  entityType    String
  action        AuditAction
  changedFields Json?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([entityId, entityType])
  @@index([userId])
}

model Comment {
  id             String      @id @default(uuid())
  text           String
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId   String?
  submission     Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  suggestionId   String?
  suggestion     Suggestion? @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([submissionId])
  @@index([suggestionId])
  @@index([userId])
}

model SubmissionVersion {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  versionNum   Int
  dataSnapshot Json
  updatedById  String?
  updatedBy    User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}

model GeneratedReport {
  id          String   @id @default(uuid())
  title       String
  fileUrl     String?
  status      String   @default("Pending") // Pending, Generating, Completed, Failed
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model Attachment {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  hash         String   @unique
  filePath     String
  url          String
  createdAt    DateTime @default(now())
}
